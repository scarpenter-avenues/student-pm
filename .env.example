# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These values identify your Firebase project to the browser; access is controlled by the security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your program's id from program.config.json (program.id).
VITE_PROGRAM_ID=

# Local development: "true" connects to the Firebase emulators instead of the real project.
# `npm run dev` sets this for you; leave it out for production builds.
# VITE_USE_EMULATORS=true

# Used by `npm run dev` (vite --mode emulator). No real Firebase project or keys needed:
# "demo-" project IDs only ever talk to the local emulators.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-switchback
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-switchback.firebaseapp.com
VITE_PROGRAM_ID=example-robotics

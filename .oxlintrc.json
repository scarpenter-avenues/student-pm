{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "vue",
    "vitest"
  ],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": [
        "tests/rules/**"
      ],
      "rules": {
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": [
              "expect",
              "assertSucceeds",
              "assertFails"
            ]
          }
        ]
      }
    }
  ]
}
